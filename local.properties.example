# Copy to local.properties (not committed) to override the defaults. Use forward slashes.

# Modpack instance (the folder that contains "mods").
# Default: <home>/curseforge/minecraft/Instances/FTB Infinity Evolved
#instanceDir=D:/Games/FTB Infinity Evolved

# Also install the mods into a server.
#serverDir=D:/Servers/infinity

# Folder with a modern vanilla Minecraft (contains versions/ and assets/), used for the combat sound pack.
# Default: %APPDATA%/.minecraft, then <home>/curseforge/minecraft/Install
#minecraftDir=C:/Users/you/curseforge/minecraft/Install
#assetsVersion=1.21.1

# Set to false to skip downloading the Modernity texture packs.
#texturePacks=false

# Set to false to skip installing the shader pack.
#shaders=false
